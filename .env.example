# Telegram bot token from @BotFather (TELOXIDE_TOKEN also works)
BOT_TOKEN=0123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Database. docker-compose builds DATABASE_URL from the POSTGRES_* values.
POSTGRES_DB=dickgrowerbotdb
POSTGRES_USER=dickgrowerbot
POSTGRES_PASSWORD=change-me
# Only when running without docker-compose:
DATABASE_URL=postgres://dickgrowerbot:change-me@localhost:5432/dickgrowerbotdb

# Game settings (these are the defaults)
GROWTH_MIN=-5
GROWTH_MAX=10
GROW_SHRINK_RATIO=0.5
GROWTH_DOD_BONUS_MAX=5
NEWCOMERS_GRACE_DAYS=7
TOP_LIMIT=10
INACTIVITY_DAYS=7
HIDE_INACTIVE_ZERO_LENGTH_FROM_TOP=true
HELP_PUSSIES_COEF=0.01
LOAN_PAYOUT_COEF=0.1
DOD_RICH_EXCLUSION_RATIO=0.1
PVP_CHECK_ACCEPTOR_LENGTH=false
PVP_STATS_SHOW=true
DEBUG=false

# The bot backs up the database with pg_dump on start and every 24h.
# Files older than this many days are deleted. 0 = no backups.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
